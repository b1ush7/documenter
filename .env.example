# Documenter 环境变量示例
#
# 用法：复制为 .env 后填入真实值，或在部署平台的环境变量里配置。
# .env 已被 .gitignore 忽略，不要提交真实密钥。
# Spring Boot 不会自动读取 .env 文件，本地开发请在启动配置里设置，或使用 IDE 的 EnvFile 插件。

# ---- 数据库（MariaDB 10.6+ / 11.x）----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=documenter
DB_USERNAME=root
DB_PASSWORD=

# ---- Redis（双 Token 会话依赖，必须可用）----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---- JWT ----
# 生产环境必须设置为足够长的随机串（建议 32 字节以上），否则任何人可伪造 Token
JWT_SECRET_KEY=

# ---- 本地文件存储（P0-4）----
STORAGE_LOCAL_ROOT=./data/storage
STORAGE_LOCAL_TEMP=./data/tmp
# 单文件与每日上传上限在 application.yaml 的 res.storage.upload 下调整

# ---- 日志 ----
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
