# Documenter 环境变量示例
#
# 用法：复制为 .env 后填入真实值，或在部署平台的环境变量里配置。
# .env 已被 .gitignore 忽略，不要提交真实密钥。
# Spring Boot 不会自动读取 .env 文件，本地开发请在启动配置里设置，或使用 IDE 的 EnvFile 插件。

# ---- 数据库（MariaDB 10.6+ / 11.x）----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=documenter
DB_USERNAME=root
DB_PASSWORD=

# ---- Redis（双 Token 会话依赖，必须可用）----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---- JWT ----
# 生产环境必须设置为足够长的随机串（建议 32 字节以上），否则任何人可伪造 Token
JWT_SECRET_KEY=

# ---- 模型密钥加密（TODO 3.2）----
# 用于加密数据库中保存的模型 API Key（AES-256-GCM），至少 32 字节。
# 留空时应用仍可启动，但通过 /admin/model-configs 保存密钥会明确报错，
# 不会静默存成明文。
# 注意：更换该值会导致已保存的密文无法解密，届时需要重新录入模型密钥。
MODEL_CONFIG_SECRET=

# ---- PDF / XLSX 处理限制 ----
PDF_MAX_EXTRACTED_CHARS_PER_PAGE=100000
PDF_MAX_EXTRACTED_CHARS_TOTAL=2000000
PDF_PREVIEW_DPI=144
PDF_MAX_PREVIEW_DPI=200
XLSX_MAX_READ_CELLS=100000
XLSX_MAX_EDIT_OPERATIONS=500
XLSX_MAX_STRUCTURAL_UNITS=1000
XLSX_MAX_SORTABLE_CELLS=10000

# ---- 页面版式预览与兼容性验收（TODO 3.3 / 4.1）----
# 预览渲染的默认 DPI 与上限
PREVIEW_DEFAULT_DPI=110
PREVIEW_MAX_DPI=200
PREVIEW_MAX_PAGE_PIXELS=40000000
# 渲染后端：none / kit。
# none 时 PDF 与图片预览仍可用；DOCX/XLSX 的版式预览与兼容性验收会返回
# 明确的可操作提示（不会静默失败）。
# kit 指打包好的 LibreOffice kit（Node CLI），提供页面渲染与格式转换。
PREVIEW_OFFICE_BACKEND=none
PREVIEW_OFFICE_KIT_NODE=
PREVIEW_OFFICE_KIT_CLI=
PREVIEW_OFFICE_TIMEOUT=120s
PREVIEW_OFFICE_MAX_INPUT_BYTES=52428800
# 中文字体（TODO 4.3）
# 实测限制（Windows + 内置 native 后端）：这些参数会传给渲染工具并影响
# missingFonts 诊断，但不改变实际渲染结果 —— 该后端渲染时直接取操作系统字体库。
# 传入只含拉丁字体的目录后，渲染产物与使用系统字体时逐字节相同（PNG SHA-256 一致）。
# 因此 Windows 上中文能正确渲染的前提是宿主机装了中文字体；
# Linux 的字体解析由 fontconfig 决定，该目录可能真正生效，但尚未在 Linux 验证。
# 这些参数的作用是让缺字问题在兼容性报告里可见（WARNING），而不是修好它。
# 多个目录用系统路径分隔符（Windows 为 ; Linux 为 :）连接。
PREVIEW_FONT_DIRECTORY=
# 缺字时的后备字体族（逗号分隔）
PREVIEW_FONT_FALLBACKS=
# 未显式指定字体的内容使用的初始字体族
PREVIEW_INITIAL_FONT_FAMILY=
# 兼容性验收：最多检查页数与渲染 DPI
PREVIEW_COMPAT_MAX_PAGES=20
PREVIEW_COMPAT_DPI=110
# 页面边缘裁切检测范围（像素），0 表示关闭
PREVIEW_CLIPPING_MARGIN=2
# 版式预览缓存（放存储临时目录，由清理任务回收）
PREVIEW_CACHE_ENABLED=true
PREVIEW_CACHE_DIRECTORY=preview-cache

# ---- 本地文件存储（P0-4）----
STORAGE_LOCAL_ROOT=./data/storage
STORAGE_LOCAL_TEMP=./data/tmp
STORAGE_TEMP_CLEANUP_ENABLED=true
STORAGE_TEMP_RETENTION=24h
STORAGE_TEMP_CLEANUP_INTERVAL=1h
STORAGE_MAX_PDF_PAGES=200
STORAGE_MAX_IMAGE_PIXELS=40000000
STORAGE_MAX_ARCHIVE_ENTRIES=10000
STORAGE_MAX_ARCHIVE_EXPANDED_BYTES=209715200
STORAGE_MAX_ARCHIVE_COMPRESSION_RATIO=200
# 单文件大小与每日上传次数仍在 application.yaml 的 res.storage.upload 下调整

# ---- 智能体与文本模型（TODO 4.2）----
# 总开关。false 时对话接口返回明确提示，其余功能不受影响
AI_ENABLED=false
# 提供方：auto / openai / stub
# auto：配齐 base-url + api-key + model-name 就用真实模型，否则回退桩模型
# stub：强制使用桩模型（无网络的测试与演示环境，产出非真实模型结果）
AI_PROVIDER=auto
# 必须指向兼容 OpenAI 协议的端点
# 例：https://dashscope.aliyuncs.com/compatible-mode/v1 （百炼兼容模式）
#     http://localhost:11434/v1                        （Ollama）
AI_BASE_URL=
# 密钥。不要写进版本库，用环境变量注入
AI_API_KEY=
AI_MODEL_NAME=
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT=60s
AI_MAX_RETRIES=2
# ---- 智能体循环上限 ----
# 必须有上限：模型可能陷入「调用工具 → 结果不理想 → 再调用」的循环
AI_MAX_STEPS=8
AI_MAX_TOOL_CALLS=12
AI_MAX_SAME_TOOL_REPEATS=4
AI_MAX_MODEL_RETRIES=1
# ---- 提示词与上下文 ----
AI_MAX_DOCUMENT_CHARS=12000
AI_MAX_TOOL_RESULT_CHARS=6000
AI_RECORD_TOOL_MESSAGES=true
# 提交前确认：编辑类工具只产出计划，不直接落版本
AI_REQUIRE_CONFIRMATION=true
# ---- 成本统计 ----
# 默认 0 表示不计价。真实价格随模型与供应商变动，因此要求显式配置，
# 而不是内置一张容易过期的价目表（过期价目比没有更糟）
AI_COST_PER_1K_INPUT=0
AI_COST_PER_1K_OUTPUT=0
# 0 为不限额，正数按 ChatModel 尝试计数（包含失败与智能体重试）。
AI_DAILY_CALL_LIMIT=0
# 自然日额度统一时区，各应用实例保持一致。
AI_QUOTA_ZONE=Asia/Shanghai

# ---- 日志 ----
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
